{
  "copilot.mcp.tools": {
    "mcp.servers": {
      "mcp-rules-assistant": {
        "command": "python3",
        "args": ["-m", "mcp_rules_assistant.cli", "start"],
        "cwd": "${workspaceFolder}",
        "env": {
          "PYTHONUNBUFFERED": "1",
          "MCP_PROJECT_ROOT": "${workspaceFolder}",
          "MCP_STRICT_ISOLATION": "1"
        }
      }
    }
  },
  "github.pullRequests.queries": [],
  "github.pullRequests.remotes": [],
  "git.enableSmartCommit": false,
  "git.fetchOnPull": false,
  "git.autofetch": false,
  "markdown.validate.enabled": true,
  "ruleflow.python.path": "${workspaceFolder}/.mcp/venv/bin/python",
  "ruff.path": ["${workspaceFolder}/.mcp/venv/bin/ruff"],
  "ruff.interpreter": ["${workspaceFolder}/.mcp/venv/bin/python"],
  "java.configuration.updateBuildConfiguration": "disabled",
  "java.import.gradle.enabled": false,
  "java.compile.nullAnalysis.mode": "disabled",
  "java.autobuild.enabled": false,
  "java.project.sourcePaths": [],
  "java.project.referencedLibraries": [],
  "files.exclude": {
    "**/extensions/jetbrains/**": true,
    "**/extensions/visualstudio/**": true,
    "**/extensions/eclipse/**": true,
    "**/.gradle": true,
    "**/build": true,
    "**/*.class": true
  },
  "files.watcherExclude": {
    "**/extensions/jetbrains/**": true,
    "**/extensions/visualstudio/**": true,
    "**/extensions/eclipse/**": true
  },
  "search.exclude": {
    "**/extensions/jetbrains/**": true,
    "**/extensions/visualstudio/**": true,
    "**/extensions/eclipse/**": true
  }
}
