<idea-plugin>
  <id>com.ruleflow.mcp</id>
  <name>RuleFlow MCP</name>
  <vendor email="" url="">ruleflow</vendor>
  <description>Minimal tool window for RuleFlow MCP (JSON-RPC/stdio).</description>
  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="RuleFlow" anchor="right" factoryClass="com.ruleflow.RuleFlowToolWindowFactory"/>
  </extensions>

  <actions>
    <action id="RuleFlowOpenPlan" class="com.ruleflow.OpenPlanAction" text="RuleFlow: Open Plan" description="Open .mcp/plan.md in editor"/>
  </actions>
</idea-plugin>
