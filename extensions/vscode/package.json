{
  "name": "mcp-rules-assistant",
  "displayName": "RuleFlow: Rules & Memory (MCP)",
  "publisher": "ruleflow",
  "version": "0.3.1",
  "description": "Rules enforcement + rolling context memory across IDEs (VS Code + MCP server). No telemetry.",
  "repository": {
    "type": "git",
    "url": "https://github.com/efem1978/Contextual-Cohesion-and-Programming-Rules-Assistant-MCP-Tool.git"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "keybindings": [
      {
        "command": "mcpRulesAssistant.openPanel",
        "key": "ctrl+shift+r",
        "when": "editorTextFocus && !isMac"
      },
      {
        "command": "mcpRulesAssistant.openPanel",
        "key": "cmd+shift+r",
        "when": "editorTextFocus && isMac"
      },
      {
        "command": "mcpRulesAssistant.nlCommand",
        "key": "ctrl+shift+l",
        "when": "editorTextFocus && !isMac"
      },
      {
        "command": "mcpRulesAssistant.nlCommand",
        "key": "cmd+shift+l",
        "when": "editorTextFocus && isMac"
      },
      {
        "command": "mcpRulesAssistant.loadCoverage",
        "key": "ctrl+shift+alt+l",
        "when": "editorTextFocus && !isMac"
      },
      {
        "command": "mcpRulesAssistant.loadCoverage",
        "key": "cmd+shift+alt+l",
        "when": "editorTextFocus && isMac"
      }
    ],
    "commands": [
      {
        "command": "mcpRulesAssistant.openPanel",
        "title": "RuleFlow: Open Panel"
      },
      {
        "command": "mcpRulesAssistant.oneClickSetup",
        "title": "RuleFlow: One-Click Setup (Newbie)"
      },
      {
        "command": "mcpRulesAssistant.newbieGuide",
        "title": "RuleFlow: Newbie Guide (Conversational)"
      },
      {
        "command": "mcpRulesAssistant.ask",
        "title": "RuleFlow: Ask (Natural Command)"
      },
      {
        "command": "mcpRulesAssistant.quickActions",
        "title": "RuleFlow: Quick Actions"
      },
      {
        "command": "mcpRulesAssistant.loadCoverage",
        "title": "RuleFlow: Load Coverage"
      },
      {
        "command": "mcpRulesAssistant.statusUpdate",
        "title": "RuleFlow: Status Update"
      },
      {
        "command": "mcpRulesAssistant.ingestQuick",
        "title": "RuleFlow: Ingest Rules (Quick)"
      },
      {
        "command": "mcpRulesAssistant.openStatus",
        "title": "RuleFlow: Open Status"
      },
      {
        "command": "mcpRulesAssistant.planSet",
        "title": "RuleFlow: Plan Set (status/current/next)"
      },
      {
        "command": "mcpRulesAssistant.memoryAppendSelection",
        "title": "RuleFlow: Memory — Append Selection"
      },
      {
        "command": "mcpRulesAssistant.fsApplyPatch",
        "title": "RuleFlow: Guarded Write (fs.apply_patch)"
      },
      {
        "command": "mcpRulesAssistant.openPlan",
        "title": "RuleFlow: Open Plan"
      },
      {
        "command": "mcpRulesAssistant.openMemory",
        "title": "RuleFlow: Open Memory"
      },
      {
        "command": "mcpRulesAssistant.commit",
        "title": "RuleFlow: Commit (run checks)"
      },
      {
        "command": "mcpRulesAssistant.push",
        "title": "RuleFlow: Push (run gates)"
      },
      {
        "command": "mcpRulesAssistant.nlCommand",
        "title": "RuleFlow: Natural Command"
      },
      {
        "command": "mcpRulesAssistant.licenseStatus",
        "title": "RuleFlow: License Status"
      },
      {
        "command": "mcpRulesAssistant.licenseActivate",
        "title": "RuleFlow: License Activate"
      },
      {
        "command": "mcpRulesAssistant.licenseVerify",
        "title": "RuleFlow: License Verify"
      },
      {
        "command": "mcpRulesAssistant.envPrepareInstall",
        "title": "RuleFlow: Prepare Env (Create + Install)"
      },
      {
        "command": "mcpRulesAssistant.panelDiag",
        "title": "RuleFlow: Panel Diagnostics (fallback)"
      },
      {
        "command": "mcpRulesAssistant.backendDoctor",
        "title": "RuleFlow: Backend Doctor"
      },
      {
        "command": "mcpRulesAssistant.installRemote",
        "title": "RuleFlow: Install to Remote (Force)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node scripts/prep-workspace.js && npm run compile && c8 --exclude='out/test/**' --exclude='out/extension.js' --exclude='out/**/panel*.js' --reporter=lcov --reporter=text node ./out/test/runTest.js",
    "test:fake": "RULEFLOW_TEST_FAKE=1 npm test",
    "test:real": "RULEFLOW_TEST_FAKE=0 npm test",
    "package": "vsce package --no-dependencies",
    "img:png": "node scripts/svg2png.js",
    "img:shots": "node scripts/svgshots.js"
  },
  "keywords": [
    "mcp",
    "coverage",
    "rules",
    "memory",
    "gate",
    "ci"
  ],
  "icon": "images/icon-128.png",
  "galleryBanner": {
    "color": "#0b5fff",
    "theme": "dark"
  },
  "screenshots": [
    {
      "path": "images/screenshot1.png",
      "label": "Panel Overview"
    },
    {
      "path": "images/screenshot2.png",
      "label": "Coverage & CI"
    }
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.84.0",
    "@vscode/test-electron": "^2.3.4",
    "c8": "^9.1.0",
    "mocha": "^10.2.0",
    "sharp": "^0.33.5",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.0.0"
  }
}